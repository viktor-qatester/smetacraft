# Скопируйте в deploy/aeza.local.env. Этот пример можно хранить в Git.
# deploy/aeza.local.env в Git не попадает: там только адрес SSH, без паролей и без .env сервера.
#
# Команда не спрашивает пароль. Нужен SSH-ключ, который сервер уже принимает.
# Если ключ лежит не в стандартном месте, укажите его в AEZA_SSH_IDENTITY.

AEZA_SSH_TARGET=ПОЛЬЗОВАТЕЛЬ@77.110.101.123
# AEZA_SSH_IDENTITY=C:\Users\Victor\.ssh\ваш_ключ
